generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model demographics {
  phoneNumber   String   @id
  takeCount     Int
  donateCount   Int
  name          String
  householdSize Int
  address       String
  lastVisitDate DateTime
}

model inventory {
  itemName     String
  categoryName String
  quantity     Int
  units        String
  lastUpdated  DateTime

  @@id([itemName, units])
}

model categories {
  itemName String
  units    String[]
  name     String

  @@id([itemName, name])
}
